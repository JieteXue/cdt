# Generated by cdt init zsh. No user data is evaluated as shell code.
_cdt_records() {
  emulate -L zsh
  setopt localoptions pipefail
  command cdt "$@" | command cdt __decode
}

cdt() {
  emulate -L zsh
  local arg
  local -a query
  local ended=0
  for arg in "$@"; do
    if (( ! ended )) && [[ "$arg" == -- ]]; then
      ended=1
    elif (( ! ended )) && [[ "$arg" == -* && "$arg" != - ]]; then
      command cdt "$@"
      return $?
    else
      query+=("$arg")
    fi
  done
  if (( ! $# )) || [[ "$1" == init && "$2" == zsh ]]; then
    command cdt "$@"
    return $?
  fi
  local raw
  raw=$(_cdt_records __query -- "${query[@]}") || return
  local -a records _cdt_paths _cdt_labels
  records=("${(@0)raw}")
  local i
  for (( i=1; i < $#records; i+=2 )); do
    _cdt_paths+=("${records[i]}")
    _cdt_labels+=("${records[i+1]}")
  done
  if (( ! $#_cdt_paths )); then
    print -u2 -r -- "cdt: no matching directory"
    return 1
  fi
  local selected="${_cdt_paths[1]}"
  if (( $#_cdt_paths > 1 )); then
    if [[ ! -o interactive || ! -t 0 || ! -t 1 ]]; then
      print -u2 -r -- "cdt: ambiguous query; use -l or add tags"
      return 2
    fi
    (( $+functions[compdef] )) || { autoload -Uz compinit; compinit; }
    zmodload zsh/complist || return
    bindkey -N _cdt_select emacs
    local binding
    local -a menu_keys menu_bindings fields
    menu_keys=('^M' '^J' '^G' '^C')
    for arg in "${menu_keys[@]}"; do
      binding=$(bindkey -M menuselect "$arg")
      fields=("${(@z)binding}")
      menu_bindings+=("${(Q)fields[2]}")
    done
    bindkey -M menuselect '^M' .accept-line
    bindkey -M menuselect '^J' .accept-line
    bindkey -M menuselect '^G' .send-break
    bindkey -M menuselect '^C' .send-break
    bindkey -M _cdt_select '^I' _cdt_menu
    bindkey -M _cdt_select '^G' send-break
    zle -C _cdt_menu menu-select _cdt_candidates
    zle -N _cdt_start
    selected=''
    local accepted=0
    {
      vared -e -M _cdt_select -i _cdt_start -p 'cdt> ' selected || return 130
      accepted=1
    } always {
      for (( i=1; i <= $#menu_keys; i++ )); do
        bindkey -M menuselect "${menu_keys[i]}" "${menu_bindings[i]}"
      done
      bindkey -D _cdt_select
      zle -D _cdt_menu _cdt_start
      if (( ! accepted )); then
        print -u2 -r -- "cdt: cancelled; directory unchanged"
      fi
    }
    # Never accept an edited path that was not in the original result set.
    (( ${_cdt_paths[(Ie)$selected]} )) || {
      print -u2 -r -- "cdt: invalid selection; directory unchanged"
      return 1
    }
  fi
  builtin cd -- "$selected" || return
  if [[ -o interactive && -t 2 ]]; then
    print -u2 -r -- "cdt: entered ${_cdt_labels[${_cdt_paths[(Ie)$selected]}]}"
  fi
  return 0
}

_cdt_candidates() {
  compadd -U -Q -V cdt -d _cdt_labels -- "${_cdt_paths[@]}"
}

_cdt_start() {
  zle _cdt_menu
  # SIGINT can leave only the menu layer; do not leave an editable path behind.
  [[ "$KEYS" == $'\r' || "$KEYS" == $'\n' ]] || zle .send-break
}

_cdt() {
  local context state state_descr line
  typeset -A opt_args
  _arguments -s \
    '(-d --delete -r --remove -l --list -e --edit --tags --explain)'{-a,--add}'[register directory / add tags]' \
    '(-a --add -r --remove -l --list -e --edit --tags --explain)'{-d,--delete}'[unregister directory]' \
    '(-a --add -d --delete -l --list -e --edit --tags --explain)'{-r,--remove}'[remove explicit tags]' \
    '(-a --add -d --delete -r --remove -e --edit --tags --explain)'{-l,--list}'[list records]' \
    '(-a --add -d --delete -r --remove -l --list -p --path --tags --explain *)'{-e,--edit}'[edit registry]' \
    '(-p --path --tags --explain)'{-p,--path}'[target directory]:directory:_directories' \
    '(--tags --explain)--doctor[check registry]' \
    '(-a --add -d --delete -r --remove -l --list -e --edit -p --path --doctor --explain *)--tags[list tags and direct directory counts]' \
    '(-a --add -d --delete -r --remove -l --list -e --edit -p --path --doctor --tags)--explain[explain tag matching]' \
    '(-h --help)'{-h,--help}'[show help]' \
    '(-V --version)'{-V,--version}'[show version]' \
    '*:tag:->tags'
  if [[ "$state" == tags ]]; then
    local raw
    local -a records tags chosen
    # Only positional tags already parsed by _arguments constrain suggestions.
    chosen=("${line[@]}")
    (( $#chosen )) && chosen[-1]=()
    raw=$(_cdt_records __complete -- "${chosen[@]}" 2>/dev/null) || return
    records=("${(@0)raw}")
    local i
    for (( i=1; i < $#records; i+=2 )); do
      (( ${chosen[(Ie)${records[i]}]} )) || tags+=("${records[i]}")
    done
    compadd -- "${tags[@]}"
  fi
}

if (( $+functions[compdef] )); then
  compdef _cdt cdt
elif [[ -o interactive ]]; then
  autoload -Uz compinit
  compinit
  compdef _cdt cdt
fi
